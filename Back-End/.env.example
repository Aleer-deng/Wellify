WELLIFY_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=https://localhost:5173,https://127.0.0.1:5173
# Leave POSTGRES_DB unset to use SQLite locally.
# POSTGRES_DB=wellify
# POSTGRES_USER=wellify
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
HRW_ISSUER_PUBLIC_KEY=

# Social sign-in: leave blank until your provider apps are registered.
# Use the same hostname as the browser and provider callback registrations.
WELLIFY_FRONTEND_URL=https://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
# The .p8 key contents, with literal \n between lines. Keep this server-side.
APPLE_PRIVATE_KEY=

# Password reset mail: server-side credentials only. Links expire in 30 minutes.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost
# For multiple workers use a shared cache, e.g. Django RedisCache (install redis).
# WELLIFY_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# WELLIFY_CACHE_LOCATION=redis://127.0.0.1:6379/1
